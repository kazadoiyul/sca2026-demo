{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {},
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": ["name", "category", "city", "country", "link"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "name": {
                        "label": "Chapter",
                        "format": "text"
                    },
                    "category": {
                        "label": "Type",
                        "format": "text"
                    },
                    "city": {
                        "label": "City",
                        "format": "text"
                    },
                    "country": {
                        "label": "Country",
                        "format": "text"
                    },
                    "link": {
                        "label": "Link",
                        "format": "link"
                    }
                }
            }
        }
    }
}
